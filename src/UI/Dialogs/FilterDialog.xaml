<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BrushCardBg}"
        Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search Box -->
        <TextBox x:Name="TxtSearch" Grid.Row="0" Height="32" Margin="0,0,0,10"/>

        <!-- Select All Checkbox -->
        <Border Grid.Row="1" Background="#161B26" CornerRadius="5" Padding="8,6" Margin="0,0,0,8" BorderBrush="#222838" BorderThickness="1">
            <CheckBox x:Name="CbSelectAll" Content="(Alles ausw&#x00E4;hlen)"/>
        </Border>

        <!-- Values Scroll Viewer -->
        <Border Grid.Row="2" Background="#10131A" CornerRadius="6" BorderBrush="#1C212E" BorderThickness="1" Margin="0,0,0,14" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PnlItems" Margin="4,2"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Abbrechen" Width="90" Height="32" Margin="0,0,10,0"/>
            <Button x:Name="BtnOk" Content="OK" Style="{StaticResource PrimaryBtn}" Width="90" Height="32"/>
        </StackPanel>
    </Grid>
</Border>
