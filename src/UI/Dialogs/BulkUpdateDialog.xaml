<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BrushCardBg}"
        Padding="20">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Status / Info Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Column Selection -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Percent Input with +/- Selector -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Live Preview Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Flexible Space -->
            <RowDefinition Height="*"/>
            <!-- 5: Action Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status / Info Banner -->
        <Border x:Name="BannerBorder" Grid.Row="0" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Background="#16231C" BorderBrush="#1C3829" BorderThickness="1">
            <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold" Foreground="#10B981"/>
        </Border>

        <!-- Column Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Label Content="Spalte w&#x00E4;hlen:" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbColumns" Height="34"/>
        </StackPanel>

        <!-- Percent Input with +/- Segmented Selector -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Label Content="Prozentuale Anpassung:" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Segmented +/- Selector -->
                <Border Grid.Column="0"
                        Background="#0F131C"
                        BorderBrush="#252D3D"
                        BorderThickness="1.2"
                        CornerRadius="7"
                        Padding="3"
                        Height="46">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>

                        <!-- Plus Button -->
                        <Border x:Name="BtnPlus"
                                Grid.Column="0"
                                CornerRadius="5"
                                Background="#10B981"
                                Cursor="Hand"
                                ToolTip="Draufrechnen / Aufschlag (+)">
                            <TextBlock x:Name="TxtPlus"
                                       Text="+"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Border>

                        <!-- Minus Button -->
                        <Border x:Name="BtnMinus"
                                Grid.Column="1"
                                CornerRadius="5"
                                Background="Transparent"
                                Cursor="Hand"
                                ToolTip="Abziehen / Abschlag (&#x2212;)">
                            <TextBlock x:Name="TxtMinus"
                                       Text="&#x2212;"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#5A6578"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Large Number Input with % Suffix -->
                <Grid Grid.Column="2" Height="46">
                    <TextBox x:Name="TxtPercentage"
                             Height="46"
                             FontSize="20"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"
                             Padding="14,0,36,0"/>
                    <TextBlock Text="%"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#5A6578"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0"
                               IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </StackPanel>

        <!-- Live Effect Pill -->
        <Border x:Name="PreviewBanner"
                Grid.Row="3"
                CornerRadius="6"
                Padding="12,7"
                Margin="0,0,0,16"
                Background="#132E22"
                BorderBrush="#1B4D36"
                BorderThickness="1">
            <TextBlock x:Name="TxtPreview"
                       Text="&#x1F4C8; +5.0 % Aufschlag (Tarif wird um 5.0 % erh&#x00F6;ht)"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#10B981"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Abbrechen" Width="100" Height="36" Margin="0,0,10,0"/>
            <Button x:Name="BtnApply" Content="Anwenden" Style="{StaticResource PrimaryBtn}" Width="110" Height="36"/>
        </StackPanel>
    </Grid>
</Border>
