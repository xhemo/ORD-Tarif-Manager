<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource BrushWindowBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="250"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSidebarBg}"
                BorderBrush="{StaticResource BrushSidebarBorder}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header & Buttons -->
                <StackPanel Grid.Row="0" Margin="14,14,14,0">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="6"
                                ClipToBounds="True"
                                Background="#0F131C"
                                BorderBrush="#232B3D"
                                BorderThickness="1.2">
                            <Image x:Name="ImgAppLogo" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="ORD_Tarif_Manager"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </Grid>

                    <Button x:Name="BtnCreateTariff"
                            Content="&#x2795;  Neuen XML Tarif erstellen"
                            Style="{StaticResource SidebarBtn}"
                            Margin="0,0,0,2"/>
                </StackPanel>

                <!-- Specifications & Recent Uploads in Sidebar (Row 1) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" Margin="0,14,0,8">
                    <StackPanel Margin="14,0,14,0" VerticalAlignment="Top">
                        <TextBlock Text="TARIFSPEZIFIKATIONEN"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="2,2,0,8"/>

                        <!-- 1. SteppedWeightDistanceConsolidation -->
                        <Border x:Name="SidebarSpecWeight"
                                Background="#0F1219"
                                BorderBrush="#1E2433"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,0,0,6"
                                Cursor="Hand"
                                ToolTip="Klicken, um auf 'Umsatz &#x2022; Gewicht (kg)' zu wechseln">
                            <StackPanel>
                                <TextBlock x:Name="TxtSidebarTagWeight"
                                           Text="Umsatz &#x2022; Gewicht (kg)"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#5A6578"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtSidebarSpecWeight"
                                           Text="SteppedWeightDistanceConsolidation"
                                           FontSize="9.5"
                                           FontWeight="Normal"
                                           Foreground="#8A96A8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. SteppedVolumeDistanceConsolidation -->
                        <Border x:Name="SidebarSpecVolume"
                                Background="#0F1219"
                                BorderBrush="#1E2433"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,0,0,6"
                                Cursor="Hand"
                                ToolTip="Klicken, um auf 'Umsatz &#x2022; Volumen (m&#x00B3;)' zu wechseln">
                            <StackPanel>
                                <TextBlock x:Name="TxtSidebarTagVolume"
                                           Text="Umsatz &#x2022; Volumen (m&#x00B3;)"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#5A6578"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtSidebarSpecVolume"
                                           Text="SteppedVolumeDistanceConsolidation"
                                           FontSize="9.5"
                                           FontWeight="Normal"
                                           Foreground="#8A96A8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 3. (TC)SteppedWeightDistanceConsolidation -->
                        <Border x:Name="SidebarSpecTcWeight"
                                Background="#0F1219"
                                BorderBrush="#1E2433"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,0,0,6"
                                Cursor="Hand"
                                ToolTip="Klicken, um auf 'Kosten &#x2022; Gewicht (kg)' zu wechseln">
                            <StackPanel>
                                <TextBlock x:Name="TxtSidebarTagTcWeight"
                                           Text="Kosten &#x2022; Gewicht (kg)"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#5A6578"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtSidebarSpecTcWeight"
                                           Text="(TC)SteppedWeightDistanceConsolidation"
                                           FontSize="9.5"
                                           FontWeight="Normal"
                                           Foreground="#8A96A8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 4. (TC)SteppedVolumeDistanceConsolidation -->
                        <Border x:Name="SidebarSpecTcVolume"
                                Background="#0F1219"
                                BorderBrush="#1E2433"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5"
                                Margin="0,0,0,4"
                                Cursor="Hand"
                                ToolTip="Klicken, um auf 'Kosten &#x2022; Volumen (m&#x00B3;)' zu wechseln">
                            <StackPanel>
                                <TextBlock x:Name="TxtSidebarTagTcVolume"
                                           Text="Kosten &#x2022; Volumen (m&#x00B3;)"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#5A6578"
                                           Margin="0,0,0,2"/>
                                <TextBlock x:Name="TxtSidebarSpecTcVolume"
                                           Text="(TC)SteppedVolumeDistanceConsolidation"
                                           FontSize="9.5"
                                           FontWeight="Normal"
                                           Foreground="#8A96A8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ==================== ZULETZT HOCHGELADENE TARIFE ==================== -->
                        <Grid Margin="2,16,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="ZULETZT HOCHGELADEN"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    x:Name="BtnRefreshRecent"
                                    Content="&#x21BB;"
                                    ToolTip="Dateiliste aktualisieren"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Width="22" Height="19"
                                    Padding="0"
                                    Background="#111520"
                                    BorderBrush="#232B3D"
                                    BorderThickness="1"
                                    Foreground="#8A96A8"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- PROD Box -->
                        <Border Background="#0C0F17"
                                BorderBrush="#1B2232"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="#064E3B"
                                            BorderBrush="#059669"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="PROD"
                                                   FontSize="8.5"
                                                   FontWeight="Bold"
                                                   Foreground="#34D399"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Outbound"
                                               FontSize="9.5"
                                               Foreground="#64748B"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            x:Name="BtnOpenProdDir"
                                            ToolTip="Linksklick: Zuletzt hochgeladene Tarife öffnen&#x0a;Rechtsklick: Verzeichnis auswählen"
                                            Padding="6,1,7,1"
                                            Height="20"
                                            Background="#161E2E"
                                            BorderBrush="#2A374F"
                                            BorderThickness="1"
                                            Foreground="#94A3B8"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconFolderOpen}"
                                                  Stroke="#94A3B8"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Width="11" Height="10"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"/>
                                            <TextBlock Text="Ordner"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ScrollViewer x:Name="ScrollRecentProd"
                                              MaxHeight="75"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PanelRecentProd">
                                        <TextBlock Text="Lade Tarife..."
                                                   FontSize="9.5"
                                                   FontStyle="Italic"
                                                   Foreground="#5A6578"
                                                   Margin="2,4"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- TEST Box -->
                        <Border Background="#0C0F17"
                                BorderBrush="#1B2232"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="#1E3A8A"
                                            BorderBrush="#2563EB"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="TEST"
                                                   FontSize="8.5"
                                                   FontWeight="Bold"
                                                   Foreground="#60A5FA"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="Outbound Test"
                                               FontSize="9.5"
                                               Foreground="#64748B"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="2"
                                            x:Name="BtnOpenTestDir"
                                            ToolTip="Linksklick: Zuletzt hochgeladene Tarife öffnen&#x0a;Rechtsklick: Verzeichnis auswählen"
                                            Padding="6,1,7,1"
                                            Height="20"
                                            Background="#161E2E"
                                            BorderBrush="#2A374F"
                                            BorderThickness="1"
                                            Foreground="#94A3B8"
                                            Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="3"/>
                                            </Style>
                                        </Button.Resources>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconFolderOpen}"
                                                  Stroke="#94A3B8"
                                                  StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Width="11" Height="10"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"/>
                                            <TextBlock Text="Ordner"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#94A3B8"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ScrollViewer x:Name="ScrollRecentTest"
                                              MaxHeight="75"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PanelRecentTest">
                                        <TextBlock Text="Lade Tarife..."
                                                   FontSize="9.5"
                                                   FontStyle="Italic"
                                                   Foreground="#5A6578"
                                                   Margin="2,4"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Hint: Doppelklick zum Öffnen -->
                        <TextBlock Text="&#x1F4A1; Doppelklick auf Tarif zum Öffnen"
                                   FontSize="9"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,8"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2"
                        Margin="14,8,14,14"
                        Padding="8,8"
                        Background="#0B0D11"
                        BorderBrush="#171A23"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock x:Name="TxtFooter"
                               FontSize="10"
                               LineHeight="14"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap">
                        &#x00A9; 2026 Xhemajl Dvorani&#x0a;Alle Rechte vorbehalten.&#x0a;Diese Software ist privates&#x0a;geistiges Eigentum des Urhebers.&#x0a;Bereitstellung erfolgt unter Nutzungslizenz.&#x0a;Kein Eigentums&#x00FC;bertrag.&#x0a;Lizenz jederzeit ohne Vorank&#x00FC;ndigung widerrufbar.
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="14,14,14,14" ClipToBounds="False">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Header (Metadata) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Table Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Central Data Area (Table or Placeholder) -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Bottom Action Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Frame -->
            <Border x:Name="HeaderFrame"
                    Grid.Row="0"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1.2"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- 0: Name (Expanded, takes all flexible space) -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <!-- 2: Gültig ab (Compact & Fixed) -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <!-- 4: Gültig bis (Compact & Fixed) -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <!-- 6: Auftragsart (Compact & Fixed) -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <!-- 8: Spezifikation (Compact & Fixed) -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Name -->
                    <StackPanel Grid.Column="0">
                        <Label Content="Name:"/>
                        <TextBox x:Name="TxtName" Height="32"
                                 MinWidth="250"
                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                 ToolTipService.InitialShowDelay="100"/>
                    </StackPanel>

                    <!-- Valid From -->
                    <StackPanel Grid.Column="2">
                        <Label Content="G&#x00FC;ltig ab:"/>
                        <DatePicker x:Name="DpValidFrom" Width="115" Height="32"/>
                    </StackPanel>

                    <!-- Valid To -->
                    <StackPanel Grid.Column="4">
                        <Label Content="G&#x00FC;ltig bis:"/>
                        <DatePicker x:Name="DpValidTo" Width="115" Height="32"/>
                    </StackPanel>

                    <!-- Order Kind -->
                    <StackPanel Grid.Column="6">
                        <Label Content="Auftragsart:"/>
                        <ComboBox x:Name="CmbOrderKind" Width="115" Height="32">
                            <ComboBoxItem Content="Delivery" IsSelected="True"/>
                            <ComboBoxItem Content="Return"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Specification (Clickable field opening adjustment dialog) -->
                    <StackPanel Grid.Column="8">
                        <Label Content="Tarifspezifikation:"/>
                        <Border x:Name="BtnSpecSelector"
                                Width="265"
                                Height="32"
                                Background="#0F1219"
                                BorderBrush="#1E2433"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,0,10,0"
                                ToolTip="Aktive Tarifspezifikation">
                            <TextBlock x:Name="TxtSpecDisplay"
                                       Text="(TC)SteppedWeightDistanceConsolidation"
                                       FontSize="11.5"
                                       Foreground="#CBD5E1"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Table Toolbar Frame -->
            <Grid x:Name="ToolbarFrame" Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Row Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnAddRow"
                            Content="&#x2795; Zeile hinzuf&#x00FC;gen"
                            Height="32"
                            Padding="12,4"
                            Margin="0,0,10,0"/>

                    <Button x:Name="BtnDeleteRows"
                            Content="&#x2796; Alle Zeilen l&#x00F6;schen"
                            Height="32"
                            Padding="12,4"/>
                </StackPanel>

                <!-- Right Filter Action -->
                <Button x:Name="BtnClearFilters"
                        Grid.Column="2"
                        Content="&#x2716; Filter zur&#x00FC;cksetzen"
                        Height="32"
                        Padding="12,4"/>
            </Grid>

            <!-- Central Data Area -->
            <Grid x:Name="CentralDataArea" Grid.Row="2">
                <!-- Placeholder / Empty State -->
                <Border x:Name="PnlPlaceholder"
                        Background="{StaticResource BrushCardBg}"
                        BorderBrush="{StaticResource BrushCardBorder}"
                        BorderThickness="1.2"
                        CornerRadius="6">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                        <Border Width="64" Height="64"
                                CornerRadius="32"
                                Background="#151923"
                                BorderBrush="#252C3D"
                                BorderThickness="1.5"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,16">
                            <Path Data="{StaticResource IconXmlDocument}"
                                  Stroke="{StaticResource BrushAccent}"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Width="26" Height="28"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Willkommen im ORD_Tarif_Manager"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Bitte erstelle einen neuen Tarif &#x00FC;ber die Schaltfl&#x00E4;che in der linken Seitenleiste&#x000A;oder ziehe einen XML-Tarif hier ins Fenster, um ihn zu &#x00F6;ffnen."
                                   FontSize="13.5"
                                   LineHeight="22"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid (Initially Hidden) -->
                <Border x:Name="PnlTable"
                        Background="{StaticResource BrushCardBg}"
                        BorderBrush="{StaticResource BrushCardBorder}"
                        BorderThickness="1.2"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <DataGrid x:Name="DgTariff"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"/>
                </Border>

                <!-- Drag & Drop Overlay (Constrained strictly to Central Data Area) -->
                <Grid x:Name="DragOverlay"
                      Visibility="Collapsed"
                      AllowDrop="True">
                    <!-- State 1: Valid XML file detected (Emerald / Success Theme) -->
                    <Grid x:Name="PnlDragValid" Visibility="Visible">
                        <Rectangle Stroke="{StaticResource BrushSuccess}"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 3"
                                   RadiusX="6" RadiusY="6"
                                   Fill="#0C1B14"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="68" Height="68"
                                    CornerRadius="34"
                                    Background="#132A1F"
                                    BorderBrush="{StaticResource BrushSuccess}"
                                    BorderThickness="1.5"
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconXmlDocument}"
                                      Stroke="{StaticResource BrushSuccess}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="28" Height="30"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="XML-Tarifdatei hier ablegen"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="Die Tarifdaten und Parameter werden sofort eingelesen und ge&#x00F6;ffnet"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- State 2: Incompatible file detected (Red / Danger Theme) -->
                    <Grid x:Name="PnlDragInvalid" Visibility="Collapsed">
                        <Rectangle Stroke="{StaticResource BrushDanger}"
                                   StrokeThickness="2"
                                   StrokeDashArray="4 3"
                                   RadiusX="6" RadiusY="6"
                                   Fill="#1F0D11"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="68" Height="68"
                                    CornerRadius="34"
                                    Background="#2E1318"
                                    BorderBrush="{StaticResource BrushDanger}"
                                    BorderThickness="1.5"
                                    Margin="0,0,0,16"
                                    HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconFileX}"
                                      Stroke="{StaticResource BrushDanger}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="28" Height="30"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Nicht kompatibles Dateiformat!"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushDanger}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6"/>

                            <TextBlock x:Name="TxtDragInvalidReason"
                                       Text="Nur XML-Tarife (*.xml) werden unterst&#x00FC;tzt."
                                       FontSize="13"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Bottom Action Bar -->
            <Border x:Name="ActionFrame"
                    Grid.Row="3"
                    Background="{StaticResource BrushCardBg}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1.2"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,10,0,0"
                    ClipToBounds="False"
                    Panel.ZIndex="100"
                    Visibility="Collapsed">
                <Grid ClipToBounds="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnMatrixImport"
                                Content="&#x1F4CB; Aus Zwischenablage einf&#x00FC;gen"
                                Style="{StaticResource PrimaryBtn}"
                                Height="34"
                                Padding="14,5"
                                Margin="0,0,10,0"/>

                        <Button x:Name="BtnBulkUpdate"
                                Content="&#x1F4C9; %-Anpassung"
                                Height="34"
                                Padding="14,5"/>
                    </StackPanel>

                    <Grid Grid.Column="2" x:Name="PnlExportContainer" ClipToBounds="False">
                        <!-- Main Export Button -->
                        <Button x:Name="BtnGenerateXml"
                                Content="&#x1F4BE; XML generieren"
                                Style="{StaticResource SuccessBtn}"
                                Height="34"
                                Padding="16,5"/>

                        <!-- Floating Canvas Layer for Flyout and Badge -->
                        <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="0" Height="0" ClipToBounds="False">
                            <!-- Slide-Up Flyout Menu (Floats directly above BtnGenerateXml) -->
                            <Grid x:Name="FlyoutExportMenu"
                                  Canvas.Right="0"
                                  Canvas.Bottom="8"
                                  Visibility="Collapsed"
                                  Opacity="0"
                                  Panel.ZIndex="200"
                                  UseLayoutRounding="True"
                                  SnapsToDevicePixels="True">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="FlyoutTransform" Y="15"/>
                                </Grid.RenderTransform>
                                <!-- Isolated Shadow Layer (No child text -> Zero raster blur!) -->
                                <Border Background="#121622"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
                                    </Border.Effect>
                                </Border>
                                <!-- Crisp Vector Content Layer -->
                                <Border Background="#121622"
                                        BorderBrush="#262F42"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6,6"
                                        TextOptions.TextFormattingMode="Display"
                                        TextOptions.TextRenderingMode="ClearType"
                                        RenderOptions.ClearTypeHint="Enabled">
                                    <StackPanel Width="205">
                                        <Button x:Name="BtnExportProd"
                                                Content="&#x1F680;  Direkt auf PROD laden"
                                                Style="{StaticResource StandardBtn}"
                                                HorizontalContentAlignment="Left"
                                                Height="32"
                                                Padding="10,4"
                                                Margin="0,0,0,4"/>
                                        <Button x:Name="BtnExportTest"
                                                Content="&#x1F9EA;  Direkt auf TEST laden"
                                                Style="{StaticResource StandardBtn}"
                                                HorizontalContentAlignment="Left"
                                                Height="32"
                                                Padding="10,4"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Success Toast Badge with Animated Checkmark -->
                            <Grid x:Name="BadgeSuccessNotification"
                                  Canvas.Right="0"
                                  Canvas.Bottom="8"
                                  Visibility="Collapsed"
                                  Opacity="0"
                                  IsHitTestVisible="False"
                                  Panel.ZIndex="300"
                                  UseLayoutRounding="True"
                                  SnapsToDevicePixels="True">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="BadgeScale" ScaleX="0.7" ScaleY="0.7" CenterX="100" CenterY="20"/>
                                        <TranslateTransform x:Name="BadgeTranslate" Y="10"/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <!-- Isolated Shadow Layer -->
                                <Border Background="#0F241A"
                                        CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.7"/>
                                    </Border.Effect>
                                </Border>
                                <!-- Crisp Content Layer -->
                                <Border Background="#0F241A"
                                        BorderBrush="{StaticResource BrushSuccess}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        TextOptions.TextFormattingMode="Display"
                                        TextOptions.TextRenderingMode="ClearType"
                                        RenderOptions.ClearTypeHint="Enabled">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource BrushSuccess}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconCheck}"
                                                  Stroke="White"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="12" Height="10"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSuccessTitle"
                                                       Text="Gespeichert!"
                                                       FontWeight="Bold"
                                                       FontSize="12.5"
                                                       Foreground="#34D399"/>
                                            <TextBlock x:Name="TxtSuccessDetail"
                                                       Text="Erfolgreich abgelegt"
                                                       FontSize="11"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
