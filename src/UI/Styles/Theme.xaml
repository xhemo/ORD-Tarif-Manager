                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource StandardBtn}">
        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
