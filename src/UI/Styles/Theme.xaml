                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrushDangerHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrushDangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
